NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated origins of the dashboard frontend
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://firebreak:firebreak@localhost:5432/firebreak

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=firebreak
# Set for Temporal Cloud (enables TLS)
TEMPORAL_API_KEY=

# Clerk (dashboard login) — https://dashboard.clerk.com → API keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# JarvisLabs serverless LLM (OpenAI-compatible) — https://docs.jarvislabs.ai/serverless/
JARVIS_API_KEY=
JARVIS_BASE_URL=https://serverlessn.jarvislabs.net
JARVIS_DEPLOYMENT_ID=
# Must match the model your deployment serves; it needs tool calling for the investigators
JARVIS_MODEL=gemma-4-26b-a4b-it
# USD per 1M tokens, for the per-incident cost line in the final report
JARVIS_PRICE_PER_MTOK=0

SUPERMEMORY_API_KEY=sm_...

# Telemetry from the chaos lab
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# Notifications
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#incidents
PAGERDUTY_ROUTING_KEY=
GITHUB_TOKEN=

# Bearer secrets for CI deploy events and chaos-lab ground truth
DEPLOY_WEBHOOK_SECRET=change-me
CHAOS_WEBHOOK_SECRET=change-me

# Detection / incident tuning
DETECTION_INTERVAL_SECONDS=60
ZSCORE_THRESHOLD=3
RECOVERY_STABLE_MINUTES=10
ACK_ESCALATION_MINUTES=10
DEPLOY_GUARD_MINUTES=15
NOISE_COOLDOWN_MINUTES=30
INCIDENT_TOKEN_BUDGET=200000

# Run patched services in Docker to verify fixes (requires docker on the worker host)
VERIFY_WITH_DOCKER=false
